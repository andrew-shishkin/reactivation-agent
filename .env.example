# Ключи вставляются после знака «=», без пробелов и кавычек.
# Пустая строка — значит, сервис не используется.

# Битрикс24: адрес входящего вебхука с правами CRM и задачи
BITRIX_WEBHOOK_URL=

# amoCRM: часть адреса до .amocrm.ru и долгосрочный токен интеграции
AMO_SUBDOMAIN=
AMO_TOKEN=

# Статус компании в ЕГРЮЛ: dadata.ru → личный кабинет → API-ключ (10 000 проверок в сутки бесплатно)
DADATA_KEY=

# Выручка за два года, по желанию: datanewton.ru → ключ API
DATANEWTON_KEY=

# Отправка писем с вашей почты, если выбрали её в анкете.
# Яндекс: smtp.yandex.ru, Mail.ru: smtp.mail.ru, Gmail: smtp.gmail.com — порт 465.
# Пароль — не от почты, а пароль приложения из настроек безопасности ящика.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
